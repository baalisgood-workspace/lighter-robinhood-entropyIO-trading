# Copy to .env and fill in ONLY the two venues you trade. Never commit .env.

# ---- Lighter mainnet (https://app.lighter.xyz -> API keys)
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=
LIGHTER_API_KEY_PRIVATE_KEY=

# ---- Lighter Robinhood Chain (API key index must be 4-156 or 158-254; 0-3 and 157 are reserved)
LIGHTER_RH_ACCOUNT_INDEX=
LIGHTER_RH_API_KEY_INDEX=
LIGHTER_RH_API_KEY_PRIVATE_KEY=

# ---- Entropy (Hyperliquid HIP-3 dex "io")
# ACCOUNT_ADDRESS = your main wallet address (holds the funds)
# API_PRIVATE_KEY = private key of an API/agent wallet approved for that account (cannot withdraw)
ENTROPY_ACCOUNT_ADDRESS=
ENTROPY_API_PRIVATE_KEY=

# ---- Arcus (https://arcus.xyz) - dedicated Ed25519 API key registered for the account
ARCUS_ACCOUNT_ADDRESS=
ARCUS_ACCOUNT_INDEX=0
ARCUS_API_KEY=
ARCUS_API_SIGNING_KEY=
